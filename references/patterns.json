{
  "_comment": "kr-skill-release-check 규칙. regex는 ripgrep(Rust regex) 문법. severity: block=공개 금지, warn=사람이 판단.",
  "rules": [
    { "id": "kr-rrn", "name": "주민등록번호 형태", "severity": "block", "regex": "\\b\\d{6}-[1-4]\\d{6}\\b" },
    { "id": "kr-mobile", "name": "휴대전화번호", "severity": "block", "regex": "\\b01[016789]-?\\d{3,4}-?\\d{4}\\b" },
    { "id": "kr-biz-no", "name": "사업자등록번호 형태", "severity": "warn", "regex": "\\b\\d{3}-\\d{2}-\\d{5}\\b" },
    { "id": "kr-landline", "name": "유선전화번호", "severity": "warn", "regex": "\\b0(2|3[1-3]|4[1-4]|5[1-5]|6[1-4])-\\d{3,4}-\\d{4}\\b" },
    { "id": "email", "name": "이메일 주소", "severity": "warn", "regex": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}" },
    { "id": "private-ip", "name": "내부 IP 주소", "severity": "block", "regex": "\\b(10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3}|172\\.(1[6-9]|2\\d|3[01])\\.\\d{1,3}\\.\\d{1,3})\\b" },
    { "id": "internal-host", "name": "사내 도메인 형태", "severity": "warn", "regex": "\\b[a-z0-9-]+\\.(internal|corp|intra|lan)\\b" },
    { "id": "path-win", "name": "Windows 로컬 경로(사용자 이름 포함)", "severity": "warn", "regex": "[A-Za-z]:\\\\Users\\\\[^\\\\\\s\"']+" },
    { "id": "path-unix", "name": "macOS/Linux 로컬 경로(사용자 이름 포함)", "severity": "warn", "regex": "/(Users|home)/[A-Za-z0-9._-]+/" },
    { "id": "unc-share", "name": "사내 공유 폴더 경로", "severity": "block", "regex": "(\\\\\\\\[A-Za-z0-9.-]+\\\\[A-Za-z0-9$._-]+|\\b[A-Z]:\\\\(공유|사내|팀)[^\\s]*)" },
    { "id": "key-openai", "name": "API 키(sk- 형태)", "severity": "block", "regex": "\\bsk-[A-Za-z0-9_-]{20,}\\b" },
    { "id": "key-google", "name": "Google API 키", "severity": "block", "regex": "\\bAIza[0-9A-Za-z_-]{35}\\b" },
    { "id": "key-github", "name": "GitHub 토큰", "severity": "block", "regex": "\\bgh[pousr]_[A-Za-z0-9]{36,}\\b" },
    { "id": "key-aws", "name": "AWS 액세스 키", "severity": "block", "regex": "\\bAKIA[0-9A-Z]{16}\\b" },
    { "id": "key-slack", "name": "Slack 토큰", "severity": "block", "regex": "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b" },
    { "id": "private-key", "name": "개인 키 블록", "severity": "block", "regex": "-----BEGIN (RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----" },
    { "id": "assigned-secret", "name": "비밀번호·토큰 대입", "severity": "warn", "regex": "(?i)\\b(password|passwd|secret|api[_-]?key|token)\\b\\s*[:=]\\s*[\"'][^\"'\\s]{6,}[\"']" },
    { "id": "hidden-unicode", "name": "보이지 않는 유니코드 문자", "severity": "warn", "regex": "[\\x{200B}-\\x{200F}\\x{202A}-\\x{202E}\\x{2060}-\\x{2064}\\x{FEFF}\\x{E0000}-\\x{E007F}]" },
    { "id": "birth-date", "name": "생년월일 형태", "severity": "warn", "regex": "(19[5-9]\\d|200\\d)[.\\-/]\\s?(0?[1-9]|1[0-2])[.\\-/]\\s?(0?[1-9]|[12]\\d|3[01])\\b" }
  ],
  "placeholder_hints": ["example", "sample", "test", "dummy", "xxx", "0000", "1234", "your-", "홍길동", "<", "YOUR_"]
}
